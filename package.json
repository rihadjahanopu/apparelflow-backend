{
  "name": "apparelflow-backend",
  "version": "1.0.0",
  "description": "ApparelFlow ERP - Cutting Operations & Gatekeeper Verification API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "prisma generate && tsc",
    "vercel-build": "prisma generate && tsc",
